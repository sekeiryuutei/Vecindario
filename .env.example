# =====================================================================
# VECINDAD - variables de entorno. Copia este archivo a .env y ajusta.
# NUNCA subas .env a Git. Los valores de abajo son SOLO para desarrollo.
# Si un valor contiene espacios o el carácter $, enciérralo entre comillas.
# =====================================================================

# --- Marca (cambiar el nombre no requiere tocar el código) ---
APP_NAME=Vecindad
APP_COMPANY=CodeVam
# development | production
APP_ENV=development
# URL pública del frontend. En producción debe ser HTTPS y coincidir con CORS.
APP_PUBLIC_URL=http://localhost:48124

# --- Puertos EXPUESTOS en tu máquina (cámbialos si están ocupados) ---
FRONTEND_PORT=48120
BACKEND_PORT=48121
POSTGRES_PORT=48122
REDIS_PORT=48123
NGINX_PORT=48124
# Solo se usan con: docker compose --profile storage up -d
MINIO_PORT=48125
MINIO_CONSOLE_PORT=48126

# --- JWT (genera uno con: openssl rand -base64 48). Mínimo 32 caracteres ---
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- PostgreSQL (dentro de Docker el host siempre es "postgres" y el puerto 5432) ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=vecindad
DATABASE_USERNAME=vecindad
DATABASE_PASSWORD=change-me-postgres

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis

# --- CORS (orígenes permitidos, separados por coma). App nativa: https://localhost (Android) y capacitor://localhost (iOS) ---
CORS_ALLOWED_ORIGINS=http://localhost:48124,http://localhost:48120,https://localhost,capacitor://localhost

# --- Swagger UI (desactívalo en producción) ---
SWAGGER_ENABLED=true

# --- Datos de demostración (NO usar en producción) ---
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=Demo#2026!

# --- Primer superadministrador (solo instalaciones sin seed) ---
# Define ambos en el primer arranque de producción y retíralos después de verificar el acceso.
# La contraseña debe tener 12+ caracteres e incluir letras y números.
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_NAME=Administrador de plataforma

# --- Correo SMTP real. En desarrollo, MAIL_DEV_LOG_LINKS imprime los enlaces en el log si no hay SMTP ---
MAIL_DEV_LOG_LINKS=true
# Verificación SMTP dentro de /actuator/health. Déjalo en false: una caída del
# proveedor de correo no debe retirar el backend de rotación.
MAIL_HEALTH_ENABLED=false
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- WhatsApp Cloud API (webhook entrante y notificaciones salientes) ---
# El webhook se registra en https://TU_DOMINIO/api/v1/public/whatsapp/webhook
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_AI_REPLIES_ENABLED=true
# false por privacidad: el asistente no incluye saldos en el prompt.
WHATSAPP_AI_INCLUDE_FINANCIAL_DATA=false

# --- Asistente de IA (adaptador principal + respaldos en orden) ---
# Proveedores: gemini, openai (compatible con OpenAI) o local.
AI_ENABLED=true
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_PROVIDERS=local
AI_TIMEOUT_SECONDS=20

# --- Almacenamiento de documentos (volumen Docker persistente) ---
STORAGE_LOCAL_DIR=/app/storage

# --- Purga programada de tokens caducados/revocados ---
TOKEN_CLEANUP_CRON=0 30 3 * * *
TOKEN_RETENTION_DAYS=30

# --- Wompi (pagos en línea). Usa llaves reales y secretos de producción al desplegar ---
WOMPI_ENABLED=true
WOMPI_PUBLIC_KEY=pub_test_demo
WOMPI_PRIVATE_KEY=prv_test_demo
WOMPI_EVENTS_SECRET=test_events_secret
WOMPI_INTEGRITY_SECRET=test_integrity_secret
WOMPI_API_URL=https://sandbox.wompi.co/v1
# En desarrollo puede quedar vacío: Wompi rechaza redirects HTTP/localhost. En producción es obligatorio HTTPS.
WOMPI_REDIRECT_URL=

# --- Almacenamiento S3 opcional (perfil "storage"). El backend usa STORAGE_LOCAL_DIR. ---
MINIO_ROOT_USER=vecindad_minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=vecindad-files
