# =====================================================================
# VECINDAD - variables de entorno.  Copia este archivo a .env y ajusta.
# NUNCA subas .env a Git. Los valores de abajo son SOLO para desarrollo.
# Si un valor contiene espacios o el carácter $, enciérralo entre comillas.
# =====================================================================

# --- Marca (cambiar el nombre no requiere tocar el código) ---
APP_NAME=Vecindad
APP_COMPANY=CodeVam
# development | production
APP_ENV=development
APP_BASE_URL=http://localhost:48124
API_BASE_URL=http://localhost:48124/api/v1

# --- Puertos EXPUESTOS en tu máquina (cámbialos si están ocupados) ---
FRONTEND_PORT=48120
BACKEND_PORT=48121
POSTGRES_PORT=48122
REDIS_PORT=48123
NGINX_PORT=48124
MINIO_PORT=48125
MINIO_CONSOLE_PORT=48126

# --- JWT (genera uno con: openssl rand -base64 48). Mínimo 32 caracteres ---
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- PostgreSQL (dentro de Docker el host siempre es "postgres" y el puerto 5432) ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=vecindad
DATABASE_USERNAME=vecindad
DATABASE_PASSWORD=change-me-postgres

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis

# --- CORS (orígenes permitidos, separados por coma). Apps Capacitor usan capacitor://localhost ---
CORS_ALLOWED_ORIGINS=http://localhost:48124,http://localhost:48120,http://localhost,capacitor://localhost

# --- Swagger UI (desactívalo en producción) ---
SWAGGER_ENABLED=true

# --- Datos de demostración (NO usar en producción) ---
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=Demo#2026!

# --- Correo (Fase de notificaciones). En desarrollo, imprime tokens de activación en el log del backend ---
MAIL_DEV_LOG_LINKS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Almacenamiento S3 compatible. Local: MinIO. Producción: AWS S3 (Fase de documentos) ---
MINIO_ROOT_USER=vecindad_minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=vecindad-files

# --- Wompi (Fase de pagos). Sin credenciales reales no se activa ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# --- WhatsApp / Push (Fase de notificaciones) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
PUSH_PROVIDER=
