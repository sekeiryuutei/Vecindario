{
  "name": "vecindad-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Portal web y PWA de Vecindad para administración de copropiedades",
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json --port 4200",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "cap:sync": "npm run build && cap sync && node scripts/configure-native-api.mjs",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@angular/service-worker": "20.3.34",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@ionic/angular": "8.8.19",
    "html5-qrcode": "2.3.8",
    "ionicons": "8.1.0",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.40",
    "@angular/cli": "20.3.40",
    "@angular/compiler-cli": "20.3.34",
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.18.10",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3"
  }
}
