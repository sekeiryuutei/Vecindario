{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/icons/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "public-config",
      "urls": ["/api/v1/public/config"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "1h",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/actuator/**",
    "!/**/*.js",
    "!/**/*.css",
    "!/**/*.png",
    "!/**/*.webmanifest"
  ]
}
